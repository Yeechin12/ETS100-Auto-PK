<?xml version="1.0" encoding="utf-8"?>
<!-- 这个应用会解码整屏内容，所以云端备份与设备间迁移一律关掉，
     和 allowBackup="false" 一起构成完整的不外流承诺。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
